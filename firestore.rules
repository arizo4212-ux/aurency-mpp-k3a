rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Ships Master Data
    match /ships/{shipId} {
      allow read, write: if true;
    }

    // Routes Master Data
    match /routes/{routeId} {
      allow read, write: if true;
    }

    // Voyages Data
    match /voyages/{voyageId} {
      allow read, write: if true;
    }

    // Passenger Manifest
    match /passengers/{passengerId} {
      allow read, write: if true;
    }

    // Cargo Manifest
    match /cargo/{cargoId} {
      allow read, write: if true;
    }

    // Tracking Logs & Audit Trail
    match /trackingLogs/{logId} {
      allow read, write: if true;
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, write: if true;
    }

    // User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }

    // Test connection check
    match /test/{testId} {
      allow read, write: if true;
    }
  }
}
