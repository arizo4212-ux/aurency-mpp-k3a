rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Ships Master Data
    match /ships/{shipId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Routes Master Data
    match /routes/{routeId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Voyages Data
    match /voyages/{voyageId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Passenger Manifest
    match /passengers/{passengerId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Cargo Manifest
    match /cargo/{cargoId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Tracking Logs & Audit Trail
    match /trackingLogs/{logId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Test connection check
    match /test/{testId} {
      allow read: if true;
    }
  }
}
